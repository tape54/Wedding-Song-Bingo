{
  "name": "wedding-song-bingo",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Wedding Song Bingo: guests pick 3 songs, first to hear all 3 on the dance floor wins.",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "lint": "eslint .",
    "typecheck": "tsc -b",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:rules": "firebase emulators:exec --only firestore --project demo-wedding-song-bingo \"vitest run --config vitest.rules.config.ts\"",
    "e2e": "playwright test",
    "e2e:emulator": "firebase emulators:exec --only auth,firestore --project demo-wedding-song-bingo \"VITE_FIREBASE_EMULATOR=1 VITE_BACKUP_URL=https://script.google.com/macros/s/e2e-test/exec E2E_MODE=emulator playwright test\"",
    "dev:emulator": "firebase emulators:exec --only auth,firestore --project demo-wedding-song-bingo \"VITE_FIREBASE_EMULATOR=1 vite\""
  },
  "dependencies": {
    "canvas-confetti": "^1.9.4",
    "firebase": "^13.1.0",
    "qrcode.react": "^4.2.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@firebase/rules-unit-testing": "^6.0.0",
    "@playwright/test": "1.63.0",
    "@types/canvas-confetti": "^1.9.0",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "eslint": "^10.13.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "firebase-tools": "^15.34.1",
    "globals": "^17.13.0",
    "jsdom": "^30.1.3",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.72.0",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  }
}
